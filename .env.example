# Copy this file to .env and fill in real values. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# eBay developer keys — https://developer.ebay.com/my/keys
# Use SANDBOX keys while building, PRODUCTION keys once it works.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# "sandbox" or "production"
EBAY_ENV=sandbox

# EBAY_US, EBAY_GB, etc.
EBAY_MARKETPLACE=EBAY_US

# Needed only for Module 3 (publish drafts to eBay). See README "eBay auto-lister setup".
# RuName from developer.ebay.com -> your app's keys -> User Tokens -> add a redirect URL.
EBAY_REDIRECT_URI=
# Filled in by `npm run ebay-auth` after you complete the one-time consent flow.
# eBay tokens contain literal "#" characters, which dotenv treats as a comment marker
# in unquoted values — wrap this one in double quotes or it gets silently truncated.
EBAY_REFRESH_TOKEN=
# From `npm run ebay-policies`, once Business Policies are set up on the eBay account.
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# Etsy developer keys — https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_CLIENT_SECRET=
